VITE_ANALYSIS_API_URL=http://localhost:3001/api
VITE_ANALYSIS_DEBUG=false

VITE_CAMERA_IDEAL_WIDTH=640
VITE_CAMERA_IDEAL_HEIGHT=480
VITE_CAMERA_IDEAL_FPS=24

VITE_UPPER_ANALYSIS_FPS=8
VITE_FULL_BODY_ANALYSIS_FPS=4
# CAM1 alternates Face/Pose: upper FPS is the target per model (two turns per cycle).
# CAM2 still alternates Pose/Hands (each gets half its configured turn rate).
# Retained defaults; benchmark on the target laptop before raising rates.
# At 8 facial samples/s, brief blinks will be missed. Test 15-20 only after profiling.
VITE_STORAGE_SAMPLE_FPS=5
VITE_LANDMARK_MIN_VISIBILITY=0.55
VITE_CALIBRATION_DURATION_MS=3000

VITE_ANALYSIS_BATCH_INTERVAL_MS=3000
VITE_ANALYSIS_BATCH_SIZE=50
VITE_MAX_BUFFERED_SAMPLES=1500
VITE_MAX_BUFFERED_EVENTS=500

# Experimental parameters. They are not clinical thresholds.
VITE_ORIENTATION_DEVIATION_DEGREES=18
VITE_HEAD_TURN_DEGREES=25
VITE_POSTURE_CHANGE_NORMALIZED=0.12
VITE_LARGE_MOVEMENT_NORMALIZED=0.18

VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1/wasm
VITE_MEDIAPIPE_FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
VITE_MEDIAPIPE_UPPER_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task
VITE_MEDIAPIPE_FULL_POSE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_full/float16/1/pose_landmarker_full.task
VITE_MEDIAPIPE_HAND_MODEL_URL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task
